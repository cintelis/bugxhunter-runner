{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "sigilant": {
      "type": "remote",
      "url": "http://bxh-bridge:8795/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:SIGILANT_BRIDGE_TOKEN}"
      },
      "timeout": 330000
    }
  },
  "instructions": ["/etc/sigilant/AGENTS.md"],
  "permission": {
    "edit": "deny",
    "bash": "deny",
    "webfetch": "deny",
    "websearch": "deny"
  }
}
