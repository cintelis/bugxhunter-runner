# BugXHunter — copy to .env (docker/setup.ps1 generates these for you).
# NEVER commit the real .env.

# SCX.ai API key (the model provider). Prefer the key vault: set it up in the
# sidebar after the first start and the key is sealed at rest (passkey +
# passphrase) instead of sitting here in the clear. If a vault exists, this
# line is ignored.
# SCX_API=sk-scx-...

# Optional: OpenRouter (https://openrouter.ai/models) as a second provider.
# Put the key in the vault as OPENROUTER_API_KEY (keys dialog) rather than here.
# OPENROUTER_API_KEY=sk-or-...
# Comma list of OpenRouter model ids the AGENT may use (they appear in the
# Runner's model picker). The Playground sees the whole catalogue regardless.
# OPENROUTER_MODELS=anthropic/claude-sonnet-4.5,openai/gpt-6.1-sol

# Optional: Anthropic (Claude) directly (https://platform.claude.com).
# Put the key in the vault as ANTHROPIC_API_KEY (keys dialog) rather than here.
# ANTHROPIC_API_KEY=sk-ant-...
# Comma list of Claude model ids the AGENT's picker shows (default below). The
# Playground lists every model the key can use. In Docker the agent's Claude
# models are set in docker/opencode.json.
# claude-mythos-5-2 is verified-organisations-only: include it only if your key
# has access (it may not appear in the Playground's live list even when it does).
# ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5,claude-mythos-5-2
# The Playground caches a Claude chat's prompt for an hour after its last use. 5m is cheaper
# to write and suits quick back-and-forth; a pause longer than that then pays for the chat again.
# ANTHROPIC_CACHE_TTL=5m

# Optional: models on Amazon Bedrock in your own AWS account (GLM 5.3 by
# default), called directly. See "GLM 5.3 on Amazon Bedrock" in the README.
# BEDROCK_REGION=ap-southeast-2
# Ids the agent may use (the Playground lists them once a sign-in is set up).
# GLM 5.3 is global.zai.glm-5.3 from most regions, us.zai.glm-5.3 from US ones.
# BEDROCK_MODELS=global.zai.glm-5.3
# How hard Bedrock's reasoning models think when a call does not say: low,
# medium, high, xhigh or max. Unset = the model's default (max for GLM 5.3),
# which can spend a short output limit before any answer is written.
# BEDROCK_REASONING_EFFORT=medium
# Sign in with ONE of:
#  - an AWS profile (IAM Identity Center / SSO, or an assumed role). In Docker,
#    also uncomment the ~/.aws volume on the runner in docker-compose.yml.
# BEDROCK_AWS_PROFILE=my-sso-profile
#  - an OIDC role (GitHub Actions, Kubernetes): the role, and the token's file.
# AWS_ROLE_ARN=arn:aws:iam::111122223333:role/bugxhunter-bedrock
# AWS_WEB_IDENTITY_TOKEN_FILE=/var/run/secrets/tokens/aws
#  - the compute's own role (EC2 instance profile; ECS needs nothing set).
# BEDROCK_AUTH=aws
#  - a Bedrock API key: put it in the vault as AWS_BEARER_TOKEN_BEDROCK (keys
#    dialog) rather than here.
# AWS_BEARER_TOKEN_BEDROCK=

# GitHub needs nothing here: "Connect GitHub" in the sidebar signs in to the
# public BugXHunter GitHub App (read-only). A fork that registers its own app
# sets its Client ID and slug:
# GITHUB_CLIENT_ID=
# GITHUB_APP_SLUG=

# There is no password. Sign-in uses the vault's passkey (set up in the UI);
# until a vault exists the app is open on localhost.

# The vault re-locks after this many minutes without a model call or a write
# to the API (default 120; 0 = never).
# OPEN_RUNNER_VAULT_IDLE_MINUTES=120

# Secret that signs session cookies. Random per setup; set it to keep sign-ins across restarts.
OPEN_RUNNER_SECRET=

# Shared token the sandboxed agent uses to reach runner's SCX key proxy.
SCX_PROXY_TOKEN=

# Optional: host port for the UI (default 8790).
# OPEN_RUNNER_PORT=8790

# Egress control for the agent sandbox (the egress-logger sidecar).
#   monitor (default): log every outbound destination, block nothing.
#   enforce: deny-by-default to an allowlist (EGRESS_ALLOW + the model proxy).
#            Needs a rebuild (the agent image now ships iptables). The runner can
#            also flip the mode per engagement at runtime via the policy file
#            /logs/egress-policy.json ({"mode","allow"}); env EGRESS_MODE=enforce
#            is a floor that file cannot lower.
# EGRESS_MODE=monitor
# Comma list of allowed destinations under enforce — hosts, IPs or CIDRs. List
# the in-scope target(s) here (runner auto-injection is a follow-up), plus your
# out-of-band collaborator host so blind-vuln confirmation keeps working.
# e.g. EGRESS_ALLOW=target.example,oob.mycollab.net,203.0.113.0/24
# EGRESS_ALLOW=
# Upstream resolver IP(s) allowed on port 53 under enforce. On a compose network
# resolv.conf lists only Docker's embedded 127.0.0.11, which forwards upstream
# from the agent's namespace, so without this external DNS can fail under enforce.
# Set the real resolver, or give the agent an explicit `dns:`. e.g. EGRESS_DNS=1.1.1.1
# EGRESS_DNS=
# NOTE: enforce mode is defense-in-depth egress control, NOT a hard containment
# boundary — a NET_RAW agent can bypass it (AF_PACKET), and an agent restart
# reopens its namespace until re-sync. See docs/recon-security.md. Treat it as
# experimental and verify DNS/egress behaviour in your environment before relying on it.

# Optional: which published images `docker compose pull` fetches — a signed
# release tag like v1.2.3 (see SECURITY.md), or latest (default).
# BXH_VERSION=latest
# Optional: the agent image without the scan toolchain (nuclei, nmap, …), about
# half the download, for reviewing code only. Unset = the full image.
# BXH_AGENT_FLAVOR=-slim
