# Open Runner — copy to .env (docker/setup.ps1 generates these for you).
# NEVER commit the real .env.

# SCX.ai API key (the model provider). Taken from `opencode auth login` by setup.ps1.
SCX_API=sk-scx-...

# Login password for the web UI. setup.ps1 generates a random one.
OPEN_RUNNER_PASSWORD=change-me

# Secret that signs session cookies. Random per setup; set it to keep sessions across restarts.
OPEN_RUNNER_SECRET=

# Shared token the sandboxed agent uses to reach runner's SCX key proxy.
SCX_PROXY_TOKEN=

# Optional: host port for the UI (default 8790).
# OPEN_RUNNER_PORT=8790

# Optional: which published images `docker compose pull` fetches — a signed
# release tag like v1.2.3 (see SECURITY.md), or latest (default).
# BXH_VERSION=latest
