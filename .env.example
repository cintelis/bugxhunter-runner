# Open Runner — copy to .env (docker/setup.ps1 generates these for you).
# NEVER commit the real .env.

# SCX.ai API key (the model provider). Prefer the key vault: set it up in the
# sidebar after the first start and the key is sealed at rest (passkey +
# passphrase) instead of sitting here in the clear. If a vault exists, this
# line is ignored.
# SCX_API=sk-scx-...

# Optional: OpenRouter (https://openrouter.ai/models) as a second provider.
# Put the key in the vault as OPENROUTER_API_KEY (keys dialog) rather than here.
# OPENROUTER_API_KEY=sk-or-...
# Comma list of OpenRouter model ids the AGENT may use (they appear in the
# Runner's model picker). The Playground sees the whole catalogue regardless.
# OPENROUTER_MODELS=anthropic/claude-sonnet-4.5,openai/gpt-5

# There is no password. Sign-in uses the vault's passkey (set up in the UI);
# until a vault exists the app is open on localhost.

# The vault re-locks after this many minutes without a model call or a write
# to the API (default 120; 0 = never).
# OPEN_RUNNER_VAULT_IDLE_MINUTES=120

# Secret that signs session cookies. Random per setup; set it to keep sign-ins across restarts.
OPEN_RUNNER_SECRET=

# Shared token the sandboxed agent uses to reach runner's SCX key proxy.
SCX_PROXY_TOKEN=

# Optional: host port for the UI (default 8790).
# OPEN_RUNNER_PORT=8790

# Optional: which published images `docker compose pull` fetches — a signed
# release tag like v1.2.3 (see SECURITY.md), or latest (default).
# BXH_VERSION=latest
